# Which wire protocol the program author speaks: claude or openai. Unset picks
# whichever provider is configured below. With nothing configured at all, the
# Todo demo runs a fixed program instead of generating one.
LLM_PROVIDER=claude

# Base URL for whichever provider is selected. A provider-specific base URL
# below wins over this one. Any endpoint speaking either protocol works here:
# self-hosted servers, gateways, and third-party models.
#   LLM_BASE_URL=http://localhost:11434/v1

# A base URL may be set without an API key, for endpoints that do not
# authenticate. Against a custom Claude endpoint the server-side fallback beta
# is not sent, since the endpoint may not implement it.

# Claude. ANTHROPIC_MODEL defaults to claude-opus-5.
ANTHROPIC_API_KEY=sk-ant-REDACTED
ANTHROPIC_MODEL=claude-opus-5
#   ANTHROPIC_BASE_URL=https://claude.internal.example.com

# OpenAI. OPENAI_MODEL defaults to gpt-5; set it to a model your endpoint
# serves. This is also the path for OpenAI-compatible endpoints — Ollama,
# vLLM, LM Studio, OpenRouter, and similar.
OPENAI_API_KEY=sk-REDACTED
OPENAI_MODEL=gpt-5
#   OPENAI_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Capability index: which store backs semantic capability search. Leave
# CAPABILITY_DB_DSN unset and the Todo demo uses its keyword ranker instead.
# ---------------------------------------------------------------------------

CAPABILITY_DB=sqlite
CAPABILITY_DB_DSN=capabilities.db

# SQLite needs the sqlite-vector 1.0.0 extension. Absolute path; vector.so on
# Linux, vector.dylib on macOS.
SQLITE_VECTOR_EXTENSION=/absolute/path/to/vector.dylib

# Postgres needs pgvector. The role must be able to CREATE EXTENSION vector, or
# have it installed already.
#   CAPABILITY_DB=postgres
#   CAPABILITY_DB_DSN=postgres://user:REDACTED@localhost:5432/codemode?sslmode=disable

# Embeddings for the index. Anthropic publishes no embeddings API, so this
# always speaks the OpenAI protocol; point it at a local endpoint to embed
# without leaving the machine. Keys and base URL fall back to the OpenAI ones.
EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_API_KEY=sk-REDACTED
#   EMBEDDING_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Sandbox: which engine isolates the model-authored program, and its bounds.
# ---------------------------------------------------------------------------

# goja is an in-process interpreter. It denies ambient capabilities and bounds
# time and call count, but it is not a security boundary: implement Runner over
# a subprocess or container before running programs written for untrusted users.
SANDBOX_ENGINE=goja
SANDBOX_TIMEOUT=30s
SANDBOX_MAX_CALLS=50
