# Which provider writes the sandbox program. Unset picks whichever key is set,
# preferring Claude. With no key at all the Todo demo runs a fixed program.
LLM_PROVIDER=claude

# Claude. ANTHROPIC_MODEL defaults to claude-opus-5.
ANTHROPIC_API_KEY=sk-ant-REDACTED
ANTHROPIC_MODEL=claude-opus-5

# OpenAI. OPENAI_MODEL defaults to gpt-5; set it to a model your account has.
OPENAI_API_KEY=sk-REDACTED
OPENAI_MODEL=gpt-5
